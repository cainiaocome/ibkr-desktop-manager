<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IbkrManager.App.ViewModels"
        x:Class="IbkrManager.App.Views.CredentialsWindow"
        x:DataType="vm:CredentialsViewModel"
        Title="Credentials"
        Width="480"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="12">
    <TextBlock Text="IBKR Desktop credentials" FontSize="18" FontWeight="SemiBold" />
    <TextBlock Text="{Binding CurrentSource}" FontSize="12" Foreground="#888888" TextWrapping="Wrap" />

    <StackPanel Spacing="4">
      <TextBlock Text="Username" FontSize="12" Foreground="#888888" />
      <TextBox Text="{Binding Username}" Watermark="IBKR username" />
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock Text="Password" FontSize="12" Foreground="#888888" />
      <TextBox Text="{Binding Password}" PasswordChar="●" Watermark="{Binding PasswordWatermark}" />
    </StackPanel>

    <CheckBox IsChecked="{Binding Remember}" Content="Remember password (Windows Credential Manager)" />
    <CheckBox IsChecked="{Binding AlsoWriteEnvironment}"
              Content="Also write as user environment variables (plaintext in the registry)" />

    <Border IsVisible="{Binding HasError}" Background="#33E5534B" CornerRadius="6" Padding="8">
      <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
    </Border>

    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,6,0,0">
      <Button Content="Clear stored" Command="{Binding ClearCommand}" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button Content="Cancel" Command="{Binding CancelCommand}" />
        <Button Content="Save" Command="{Binding SaveCommand}" Classes="accent" IsDefault="True" />
      </StackPanel>
    </Grid>
  </StackPanel>
</Window>
