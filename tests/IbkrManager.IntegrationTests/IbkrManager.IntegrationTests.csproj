<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>IbkrManager.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IbkrManager.Core\IbkrManager.Core.csproj" />
    <ProjectReference Include="..\..\src\IbkrManager.Platform.Windows\IbkrManager.Platform.Windows.csproj" />
  </ItemGroup>

  <!-- End-to-end tests drive a real GUI process, so the stub host is built next to the tests. -->
  <Target Name="BuildAndCopyTestHost" AfterTargets="Build">
    <MSBuild Projects="..\..\src\IbkrManager.TestHost\IbkrManager.TestHost.csproj"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <TestHostFiles Include="..\..\src\IbkrManager.TestHost\bin\$(Configuration)\net8.0-windows\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(TestHostFiles)"
          DestinationFolder="$(OutDir)testhost\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
